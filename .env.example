# Copy to .env and fill in real values locally. Never commit .env.

# Supabase (new dedicated project — see docs/decisions/0002)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# SFTP deploy target (ai.vitrue.co.il/trax-crm/)
DEPLOY_SFTP_HOST=
DEPLOY_SFTP_USER=
DEPLOY_SFTP_PASSWORD=

# Edge Function secrets (set in Supabase project secrets too, not just here)
LEAD_INTAKE_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
VOICENTER_WEBHOOK_SECRET=
SUMIT_WEBHOOK_SECRET=
BACKUP_SECRET=

# OneSignal push notifications (Sahar 16.09 — task/meeting/lead alerts).
# App ID is public (ships in the frontend bundle, VITE_ prefix). REST API
# Key is a server secret — set it in Supabase project secrets, never in the
# frontend bundle.
VITE_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Voicenter API code for the TRAX Adventure Club account (Call Log / recordings). Value in GitHub secret VOICENTER_TRAX_API_CODE.
VOICENTER_TRAX_API_CODE=
